; Godot 4.7.2 project manifest for the desert spaceport vertical slice.
; Engine version is pinned in scripts/pin.txt and verified at the top of CI.

config_version=5

[application]

config/name="Desert Spaceport Slice"
run/main_scene="res://scenes/town_demo.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

NpcVoice="*res://src/systems/voice/npc_voice.gd"

; Left at defaults; UI is greybox for the slice.

[input]

; Movement + camera (M1). Key codes are Godot Key enum values.
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194320),Object(InputEventKey,"keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194322),Object(InputEventKey,"keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194319),Object(InputEventKey,"keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194321),Object(InputEventKey,"keycode":68)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":32)]
}
toggle_view={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":86),Object(InputEventMouseButton,"button_index":3,"button_mask":4)]
}
sprint_mod={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194325)]
}
crouch_act={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":67)]
}
bay_land={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":90)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":69)]
}

; Hand weapons (M11). 1/2/3 pick a weapon (again = holster), Q last, H holster.
fire={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1,"button_mask":1)]
}
alt_fire={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2,"button_mask":2)]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":82)]
}
weapon_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":49)]
}
weapon_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":50)]
}
weapon_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":51)]
}
weapon_last={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":81)]
}
holster={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":72)]
}

; Gear (M13). G puts the back-slot gear (the jetpack) on or takes it off.
gear_toggle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":71)]
}
inventory={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":73)]
}

; Flight (M10). Pitch follows a stick: W / Up pushes the nose down, S / Down pulls it up.
flight_pitch_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":83),Object(InputEventKey,"keycode":4194322)]
}
flight_pitch_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":87),Object(InputEventKey,"keycode":4194320)]
}
flight_yaw_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":65),Object(InputEventKey,"keycode":4194319)]
}
flight_yaw_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":68),Object(InputEventKey,"keycode":4194321)]
}
flight_roll_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":81)]
}
flight_roll_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":69)]
}
flight_throttle_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":82)]
}
flight_throttle_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":70)]
}
flight_boost={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194325)]
}
flight_fire={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":32),Object(InputEventMouseButton,"button_index":1,"button_mask":1)]
}
flight_missile={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":88),Object(InputEventMouseButton,"button_index":2,"button_mask":2)]
}
flight_next_target={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":84)]
}

[ui]

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="cover"
3d_physics/layer_3="player"
3d_physics/layer_4="enemies"
