; Godot 4.7.2 project manifest for the desert spaceport vertical slice.
; Engine version is pinned in scripts/pin.txt and verified at the top of CI.

config_version=5

[application]

config/name="Desert Spaceport Slice"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

; Left at defaults; UI is greybox for the slice.

[input]

; Movement + camera (M1). Key codes are Godot Key enum values.
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"key_code":4194320),Object(InputEventKey,"key_code":87),Object(InputEventKey,"key_code":83)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"key_code":4194322),Object(InputEventKey,"key_code":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"key_code":4194319),Object(InputEventKey,"key_code":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"key_code":4194321),Object(InputEventKey,"key_code":68)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"key_code":32)]
}
toggle_view={
"deadzone": 0.2,
"events": [Object(InputEventKey,"key_code":86),Object(InputEventMouseButton,"button_index":52,"button_mask":16)]
}
sprint_mod={
"deadzone": 0.2,
"events": [Object(InputEventKey,"key_code":4194325)]
}
crouch_act={
"deadzone": 0.2,
"events": [Object(InputEventKey,"key_code":67)]
}

[ui]

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="cover"
3d_physics/layer_3="player"
3d_physics/layer_4="enemies"
