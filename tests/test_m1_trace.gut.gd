extends GutTest
## M1: a headless trace of the demo (scenes/m1_trace.gd) is generated and checked
## here. It proves, without a rendered window, that the player MOVES and that the
## FPV<->TPV toggle actually switches view. CI runs the trace before this suite.

const TRACE := "res://test_results/m1_trace.txt"


func test_trace_file_exists_and_has_rows() -> void:
	assert_true(FileAccess.file_exists(TRACE), "m1 trace should be generated by CI")
	var txt: String = FileAccess.get_file_as_string(TRACE)
	# Skip the header line.
	var lines := txt.split("\n")
	var data_lines := 0
	for l in lines:
		if l.begins_with("#") or l.strip_edges().is_empty():
			continue
		data_lines += 1
	assert_gt(data_lines, 10, "the trace should record many frames of play")


func test_trace_shows_player_moving() -> void:
	var txt: String = FileAccess.get_file_as_string(TRACE)
	var moved := false
	for l in txt.split("\n"):
		if l.begins_with("#") or l.strip_edges().is_empty():
			continue
		# Split on runs of whitespace: drop empty fields (allow_empty = false).
		var parts: Array = l.replace("  ", " ").split(" ", false)
		# columns: frame, view, pos_x, pos_z
		if parts.size() >= 4:
			var x: float = parts[2].to_float()
			var z: float = parts[3].to_float()
			if absf(x) > 0.05 or absf(z) > 0.05:
				moved = true
				break
	assert_true(moved, "the player should move at some point in the trace")


func test_trace_shows_a_view_toggle() -> void:
	var txt: String = FileAccess.get_file_as_string(TRACE)
	assert_true(txt.contains("FPV"), "trace should record first-person frames")
	assert_true(txt.contains("TPV"), "trace should record third-person frames")
