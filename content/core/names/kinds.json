{
 "id": "kinds",
 "note": "Generated by tools/names/lexicon_source.py (edit there, run it, commit both). The grammar: what each kind of name is made of. Syntax is in src/systems/names/name_engine.gd.",
 "kinds": {
  "person_remnant": {
   "note": "Remnant personnel. The rank is added by whoever names them (a soldier's 'naming.titles').",
   "patterns": [
    [
     "{remnant_given} {remnant_family}",
     10
    ],
    [
     "{remnant_given:first}. {remnant_family}",
     2
    ],
    [
     "{~hard:cap} {remnant_family}",
     3
    ],
    [
     "{remnant_given} {~hard:cap}",
     3
    ],
    [
     "{remnant_given} {remnant_family}-{remnant_family}",
     1
    ]
   ],
   "min_len": 5,
   "max_len": 26
  },
  "person_dune": {
   "note": "The desert's own people: a given name and a clan, sometimes an epithet.",
   "patterns": [
    [
     "{dune_given} {@clan}",
     8
    ],
    [
     "{~dune:cap} {@clan}",
     4
    ],
    [
     "{dune_given} {dune_epithet}",
     2
    ],
    [
     "{dune_given} {@clan}[0.25| {dune_epithet}]",
     2
    ],
    [
     "{dune_given} of {dune_place_word}",
     1
    ]
   ],
   "min_len": 5,
   "max_len": 30
  },
  "person_drift": {
   "note": "Spacers and smugglers: short names, a nickname now and then.",
   "patterns": [
    [
     "{drift_given} {drift_family}",
     8
    ],
    [
     "{drift_given} \"{nickname}\" {drift_family}",
     3
    ],
    [
     "{~drift:cap} {drift_family}",
     3
    ],
    [
     "{drift_given} {~drift:cap}",
     2
    ],
    [
     "{nickname} {drift_family}",
     1
    ]
   ],
   "min_len": 5,
   "max_len": 30
  },
  "callsign": {
   "note": "A pilot's callsign. A number is added when the word alone is taken.",
   "patterns": [
    [
     "{callsign}",
     8
    ],
    [
     "{callsign} {#2-9}",
     3
    ],
    [
     "{vessel_adj} {callsign}",
     1
    ]
   ],
   "min_len": 3,
   "max_len": 22
  },
  "vessel": {
   "note": "A ship's own name (not its class).",
   "patterns": [
    [
     "{vessel_adj} {vessel_noun}",
     8
    ],
    [
     "{vessel_noun} of {vessel_abstract}",
     4
    ],
    [
     "The {vessel_adj} {vessel_noun}",
     3
    ],
    [
     "{vessel_phrase}",
     4
    ],
    [
     "{@owner}'s {vessel_noun}",
     2
    ],
    [
     "{vessel_noun} {#2-9:roman}",
     1
    ]
   ],
   "min_len": 4,
   "max_len": 32
  },
  "equipment": {
   "note": "A maker, a model code and a product name. %(class) picks the product list (jetpack, blaster, blade, ship, armor, tool).",
   "patterns": [
    [
     "{maker_root} {model_code}-{#2-99} {product_%(class)}",
     6
    ],
    [
     "{maker_root} {maker_suffix} {product_%(class)}",
     3
    ],
    [
     "{maker_root} {product_%(class)} Mk {#2-7:roman}",
     2
    ],
    [
     "{@maker_made} {model_code}-{#2-99}",
     2
    ]
   ],
   "min_len": 6,
   "max_len": 40
  },
  "maker": {
   "note": "A company.",
   "patterns": [
    [
     "{maker_root} {maker_suffix}",
     6
    ],
    [
     "{~drift:cap}-{maker_root} {maker_suffix}",
     1
    ],
    [
     "{maker_root} & {maker_root}",
     1
    ]
   ],
   "min_len": 5,
   "max_len": 32
  },
  "town": {
   "note": "A settlement in the desert.",
   "patterns": [
    [
     "{town_prefix}{town_suffix}",
     8
    ],
    [
     "{town_prefix} {town_tail}",
     5
    ],
    [
     "{~dune:cap}",
     3
    ],
    [
     "{~dune:cap} {town_tail}",
     3
    ],
    [
     "{town_owner} {town_tail}",
     2
    ],
    [
     "{town_prefix}{town_suffix} {town_tail}",
     1
    ]
   ],
   "min_len": 4,
   "max_len": 28
  },
  "planet": {
   "note": "A world.",
   "patterns": [
    [
     "{~astral:cap}",
     6
    ],
    [
     "{~astral:cap} {#2-9:roman}",
     4
    ],
    [
     "{~astral:cap} {planet_epithet}",
     3
    ],
    [
     "{planet_prefix} {~astral:cap}",
     1
    ],
    [
     "{planet_catalog}-{#100-999}",
     1
    ]
   ],
   "min_len": 4,
   "max_len": 24
  },
  "moon": {
   "note": "A moon (named after the planet it circles: pass %(planet)).",
   "patterns": [
    [
     "%(planet)'s {moon_name}",
     3
    ],
    [
     "{~astral:cap}",
     3
    ],
    [
     "%(planet) {#1-4:roman}-{moon_letter}",
     1
    ]
   ],
   "min_len": 3,
   "max_len": 30
  },
  "star": {
   "note": "A sun.",
   "patterns": [
    [
     "{~astral:cap}",
     5
    ],
    [
     "{planet_catalog} {#1000-9999}",
     2
    ],
    [
     "{~astral:cap} {star_epithet}",
     2
    ]
   ],
   "min_len": 4,
   "max_len": 24
  }
 },
 "rules": {
  "clan": [
   [
    "{dune_clan_prefix}{dune_clan}",
    5
   ],
   [
    "{dune_clan_prefix}{~dune:cap}",
    2
   ]
  ],
  "owner": [
   [
    "{drift_given}",
    3
   ],
   [
    "{dune_given}",
    2
   ],
   [
    "{remnant_given}",
    1
   ]
  ],
  "maker_made": [
   [
    "{maker_root}",
    3
   ],
   [
    "{maker_root} {maker_suffix}",
    1
   ]
  ]
 }
}
